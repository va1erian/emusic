[Unit]
Description=emusic homelab music server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=emusic
Group=emusic
ExecStart=/usr/local/bin/emusic-server --config /etc/emusic-server/server.toml
Restart=on-failure
RestartSec=3

# Hardening: the server only reads the library and writes its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/emusic-server
ReadOnlyPaths=/media/music

[Install]
WantedBy=multi-user.target
